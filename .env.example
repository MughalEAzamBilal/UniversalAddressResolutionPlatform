APP_NAME="Universal Address Resolution Platform"
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DATABASE_URL=sqlite:///./data/address_platform.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
DEFAULT_REDIRECT_SECONDS=3
ALLOWED_REDIRECT_DELAYS=[0, 1, 2, 3, 5, 10, 15, 30]
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EDIT_SESSION_EXPIRE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
